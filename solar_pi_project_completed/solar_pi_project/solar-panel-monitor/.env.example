# Solar Panel Performance Monitor - Environment configuration
# Copy this file to .env and edit the values for your deployment.
# Environment variables override values in config.json.

# Sensor mode: "simulation" (Windows/dev) or "hardware" (Raspberry Pi + INA219)
SENSOR_MODE=simulation

# Sampling interval in seconds (default: 2)
SAMPLING_INTERVAL_SECONDS=2

# INA219 I2C address (commonly 0x40; verify with `sudo i2cdetect -y 1`)
INA219_I2C_ADDRESS=0x40

# Shunt resistor value in ohms (verify against your breakout board)
INA219_SHUNT_OHMS=0.1

# Maximum expected current in amps (configure per panel/resistor)
INA219_MAX_EXPECTED_AMPS=0.5

# SQLite database file path
DATABASE_PATH=solar_monitor.db

# Flask bind address (0.0.0.0 allows local-network access; never expose to internet)
HOST=0.0.0.0

# Flask port
PORT=5000

# Flask debug mode (true/false)
DEBUG=false

# Logging level
LOG_LEVEL=INFO

# Secret key for Flask sessions (change for production)
SECRET_KEY=dev-secret-change-me
