[Unit]
Description=Solar Panel Performance Monitor (Flask dashboard)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/solar_pi_project
ExecStartPre=/home/pi/solar_pi_project/.venv/bin/python -c "import flask, ina219, smbus2"
ExecStart=/home/pi/solar_pi_project/.venv/bin/python /home/pi/solar_pi_project/src/app.py
Restart=always
RestartSec=5

# Environment (optional)
# ENV=production

[Install]
WantedBy=multi-user.target
